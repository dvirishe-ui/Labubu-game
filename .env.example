# Copy to .env and fill in to enable cloud sync. Leave empty to run fully offline.
# Option A: Supabase (recommended) - run supabase/schema.sql in your project first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Option B: Custom REST backend (used only when Supabase vars are empty).
# Must implement: GET/PUT {base}/saves/:playerId and GET/POST {base}/leaderboard
VITE_SYNC_REST_URL=
